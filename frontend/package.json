{
  "name": "arcade",
  "version": "0.1.0",
  "private": true,
  "description": "Arcade — a security ADE for AI-generated software",
  "author": "Arcade",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:electron": "electron electron/main.js",
    "desktop:preview": "cross-env ELECTRON_PROD=1 electron electron/main.js",
    "desktop:pack": "next build && electron-builder --dir",
    "desktop:build": "next build && electron-builder",
    "desktop:build:win": "next build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "dev.arcade.ade",
    "productName": "Arcade",
    "copyright": "Arcade",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!out/download/**",
      "!out/**/*.map",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Arcade-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Arcade-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Arcade-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Arcade-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "Arcade-${version}-${arch}.${ext}"
    }
  }
}
