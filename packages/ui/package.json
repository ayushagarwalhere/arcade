  },
  "dependencies": {
    "@arcade/core": "*",
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "next": "16.3.5",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
