{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@arcade/core/*": [
        "../../packages/core/src/*"
      ],
      "@arcade/agents/*": [
        "../../packages/agents/src/*"
      ],
      "@arcade/orchestrator/*": [
        "../../packages/orchestrator/src/*"
      ],
      "@arcade/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
