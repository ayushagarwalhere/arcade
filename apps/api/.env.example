# Copy to .env.local for local work. `npm run dev -w apps/api` needs none of these:
# it defaults to dev auth, an in-memory store and the model switched off.
# AWS credentials are never set here — they come from your AWS profile locally and
# from the function's IAM role when deployed.

# --- auth ---------------------------------------------------------------------
# "dev" accepts `Authorization: Bearer dev:<name>`. Refused outright inside Lambda.
ARCADE_AUTH=dev
# Required when ARCADE_AUTH is not "dev" (both are stack outputs of infra/):
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- store --------------------------------------------------------------------
# "memory" (nothing survives a restart) or "dynamo".
ARCADE_STORE=memory
# TABLE_NAME=arcade
# Point at DynamoDB Local:  docker run -d -p 8000:8000 amazon/dynamodb-local
# DYNAMO_ENDPOINT=http://localhost:8000

# --- model --------------------------------------------------------------------
# "off" makes the model endpoints answer 503. Remove to call Bedrock with your AWS profile.
ARCADE_MODEL=off
# BEDROCK_MODEL_ID=anthropic.claude-opus-5
# BEDROCK_REGION=us-east-1
# MODEL_MONTHLY_TOKEN_BUDGET=5000000
# MODEL_MAX_SOURCE_BYTES=200000

# --- misc ---------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# PORT=3002
